[Unit]
Description=Geo Widget Container Service
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/kyoobit/tornado-geo-widget:latest
ContainerName=geo-widget
PublishPort=8893:8888
Exec=--systemd --verbose
# Add volumes - format: host_path:container_path:options
Volume=/path/to/GeoLite2-ASN.mmdb:/GeoLite2-ASN.mmdb:ro
Volume=/path/to/GeoLite2-City.mmdb:/GeoLite2-City.mmdb:ro
# Ensure the container runs in foreground mode
PodmanArgs=--log-driver=journald

[Service]
Type=notify
NotifyAccess=all
Restart=always
TimeoutStartSec=900
TimeoutStopSec=70

[Install]
WantedBy=default.target

# Podman rootless Quadlet-generated systemd unit
# https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# ~/.config/containers/systemd/geo-widget.container
# systemctl --user daemon-reload
# systemctl --user start geo-widget.service
# systemctl --user status geo-widget.service
